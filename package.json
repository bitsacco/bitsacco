{
  "name": "bitsacco-home",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf .next",
    "format": "prettier --write .",
    "sanity:extract": "sanity schema extract --path=sanity/extract.json",
    "sanity:typegen": "npm run sanity:extract && sanity typegen generate",
    "docker:up": "docker compose -p bitsacco up --build -d",
    "docker:down": "docker compose -p bitsacco down",
    "docker:logs": "docker compose -p bitsacco logs -f"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.10",
    "@phosphor-icons/react": "^2.1.10",
    "@sanity/icons": "^5.2.3",
    "@sanity/image-url": "^2.1.1",
    "@sanity/vision": "^6.21.0",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.23",
    "feed": "^6.0.0",
    "next": "^16.4.3",
    "next-sanity": "^13.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-pdf": "^10.5.0",
    "react-use-measure": "^2.1.7",
    "resend": "^6.37.0",
    "sanity": "^6.21.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "@vercel/frameworks": {
      "js-yaml": "^4.3.2",
      "smol-toml": "^1.9.1"
    },
    "typeid-js": {
      "uuid": "^11.1.1"
    },
    "@module-federation/dts-plugin": {
      "undici": "^7.30.1"
    }
  },
  "engines": {
    "node": ">=24.20.0 <25",
    "npm": ">=12.0.2"
  }
}
